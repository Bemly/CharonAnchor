<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Lagrange.Core" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\appsettings.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Charon\CharonSignProvider.csproj" />
    <ProjectReference Include="..\Lagrange.Core\Lagrange.Core.csproj" />
    <!-- Generator output conflicts with the hand-written *.impl.cs replacements; opt back in
         with -p:MilkyUseGenerator=true only when the impl files are removed -->
    <ProjectReference Include="..\Lagrange.Milky.Generator\Lagrange.Milky.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(MilkyUseGenerator)' == 'true'" />
  </ItemGroup>
</Project>
